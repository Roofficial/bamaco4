rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isEmailVerified() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      return isEmailVerified() && 
        (request.auth.token.email == "ronnexpro65@gmail.com" || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
    }

    function isDoctor() {
      return isEmailVerified() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isConfirmed == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['patient', 'doctor', 'admin'] &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('onboardingCompleted' in data) || data.onboardingCompleted is bool) &&
             (!('isConfirmed' in data) || data.isConfirmed is bool);
    }

    function isValidConversation(data) {
      return data.participants is list && data.participants.size() >= 2 && data.participants.size() <= 10 &&
             request.auth.uid in data.participants &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128));
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000 &&
             data.type in ['text', 'image', 'system'];
    }

    // --- Rules ---

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
                      (incoming().role == 'patient') ||
                      (request.auth.token.email == "ronnexpro65@gmail.com" && incoming().role == 'admin') ||
                      (incoming().role == 'doctor' && incoming().isConfirmed == false)
                    );
      
      allow update: if isEmailVerified() && (
                      isAdmin() || 
                      (isOwner(userId) && isValidUser(incoming()) && (
                        // Protect critical fields from self-assignment
                        incoming().isConfirmed == existing().isConfirmed &&
                        (existing().onboardingCompleted == true ? incoming().role == existing().role : true)
                      )) ||
                      // isOnline update for any verified user
                      (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isOnline']))
                    );
    }

    match /appointments/{appointmentId} {
      allow read: if isEmailVerified() && 
                    (request.auth.uid == existing().patientId || request.auth.uid == existing().doctorId || isAdmin());
      allow create: if isEmailVerified() && 
                      (request.auth.uid == incoming().patientId || isAdmin());
      allow update: if isEmailVerified() && 
                      (request.auth.uid == existing().patientId || request.auth.uid == existing().doctorId || isAdmin());
      allow delete: if isAdmin();
    }

    match /medical_records/{recordId} {
      allow read: if isEmailVerified() && 
                    (request.auth.uid == existing().patientId || request.auth.uid == existing().doctorId || isAdmin());
      allow create: if isDoctor() || isAdmin();
      allow update: if (isDoctor() && request.auth.uid == existing().doctorId) || isAdmin();
    }

    match /calls/{callId} {
      allow read: if isEmailVerified() && (request.auth.uid == existing().initiatorId || request.auth.uid == existing().recipientId || isAdmin());
      allow create: if isEmailVerified();
      allow update: if isEmailVerified() && (request.auth.uid == existing().initiatorId || request.auth.uid == existing().recipientId || isAdmin());
    }

    match /conversations/{chatId} {
      allow list: if isEmailVerified() && request.auth.uid in existing().participants;
      allow get: if isEmailVerified() && (request.auth.uid in existing().participants || isAdmin());
      allow create: if isEmailVerified() && isValidConversation(incoming()) && isValidId(chatId);
      allow update: if isEmailVerified() && (request.auth.uid in existing().participants || isAdmin()) && isValidConversation(incoming());
      
      match /messages/{messageId} {
        allow read: if isEmailVerified() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants || isAdmin());
        allow create: if isEmailVerified() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants) && isValidMessage(incoming()) && isValidId(messageId);
      }
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}
