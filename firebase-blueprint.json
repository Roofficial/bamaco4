{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a user (Patient, Doctor, or Admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"], "description": "User role for RBAC" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether the user has completed role selection" },
        "isConfirmed": { "type": "boolean", "description": "Whether a doctor has been confirmed by an admin" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "isOnline": { "type": "boolean", "description": "Whether the user is currently connected to the server" },
        "specialty": { "type": "string", "description": "Medical specialty (for doctors only)" },
        "bio": { "type": "string", "description": "Doctor biography" },
        "experience": { "type": "number", "description": "Years of experience" },
        "rating": { "type": "number", "description": "Average patient rating" },
        "bloodType": { "type": "string", "description": "Patient blood type" },
        "allergies": { "type": "array", "items": { "type": "string" }, "description": "Patient allergies" },
        "medicalHistory": { "type": "string", "description": "Patient medical history summary" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled medical consultation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string", "description": "UID of the patient" },
        "doctorId": { "type": "string", "description": "UID of the doctor" },
        "patientName": { "type": "string" },
        "doctorName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "description": "e.g., General Checkup" }
      },
      "required": ["patientId", "doctorId", "status", "date"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "Professional medical notes and documentation",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "attachments": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["patientId", "doctorId", "content", "date"]
    },
    "CallLog": {
      "title": "Call Log",
      "description": "Record of a video consultation call",
      "type": "object",
      "properties": {
        "initiatorId": { "type": "string" },
        "initiatorName": { "type": "string" },
        "recipientId": { "type": "string" },
        "recipientName": { "type": "string" },
        "status": { "type": "string", "enum": ["initiated", "accepted", "rejected", "cancelled", "missed", "completed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in seconds" },
        "roomId": { "type": "string" }
      },
      "required": ["initiatorId", "recipientId", "status", "timestamp"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat thread between two users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" }, "description": "UIDs of participants" },
        "lastMessage": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "lastMessageSenderId": { "type": "string" },
        "unreadCount": { "type": "object", "description": "Map of userId to unread message count" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "image", "system"] }
      },
      "required": ["senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Consultation appointments"
    },
    "/medical_records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Patient medical records"
    },
    "/calls/{callId}": {
      "schema": "CallLog",
      "description": "History of calls"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    }
  }
}
